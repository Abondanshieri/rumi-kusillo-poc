(fn Probe ()
 (bind ch (Juego|GetPlayerCharacter 0))
 (bind m (Clase|Character|ObtenerMesh ch))
 (Variables|Predeterminado|EstablecerPHips :P_Hips (Transformación|GetSocketLocation :self m :InSocketName "Hips"))
 (Variables|Predeterminado|EstablecerPLeftUpLeg :P_LeftUpLeg (Transformación|GetSocketLocation :self m :InSocketName "LeftUpLeg"))
 (Variables|Predeterminado|EstablecerPLeftLeg :P_LeftLeg (Transformación|GetSocketLocation :self m :InSocketName "LeftLeg"))
 (Variables|Predeterminado|EstablecerPLeftFoot :P_LeftFoot (Transformación|GetSocketLocation :self m :InSocketName "LeftFoot"))
 (Variables|Predeterminado|EstablecerPLeftToeBase :P_LeftToeBase (Transformación|GetSocketLocation :self m :InSocketName "LeftToeBase"))
 (Variables|Predeterminado|EstablecerPRightUpLeg :P_RightUpLeg (Transformación|GetSocketLocation :self m :InSocketName "RightUpLeg"))
 (Variables|Predeterminado|EstablecerPRightLeg :P_RightLeg (Transformación|GetSocketLocation :self m :InSocketName "RightLeg"))
 (Variables|Predeterminado|EstablecerPRightFoot :P_RightFoot (Transformación|GetSocketLocation :self m :InSocketName "RightFoot"))
 (Variables|Predeterminado|EstablecerPRightToeBase :P_RightToeBase (Transformación|GetSocketLocation :self m :InSocketName "RightToeBase"))
 (Variables|Predeterminado|EstablecerRHips :R_Hips (Transformación|GetSocketRotation :self m :InSocketName "Hips"))
 (Variables|Predeterminado|EstablecerRLeftFoot :R_LeftFoot (Transformación|GetSocketRotation :self m :InSocketName "LeftFoot"))
 (Variables|Predeterminado|EstablecerRRightFoot :R_RightFoot (Transformación|GetSocketRotation :self m :InSocketName "RightFoot"))
 (Variables|Predeterminado|EstablecerRLeftLeg :R_LeftLeg (Transformación|GetSocketRotation :self m :InSocketName "LeftLeg"))
 (Variables|Predeterminado|EstablecerRRightLeg :R_RightLeg (Transformación|GetSocketRotation :self m :InSocketName "RightLeg"))
 (Variables|Predeterminado|EstablecerActorLoc :ActorLoc (Transformación|GetActorLocation :self ch))
 (Pawn|Entrada|AddMovementInput :self ch :WorldDirection (Variables|Predeterminado|ObtenerDriveDir) :ScaleValue (Variables|Predeterminado|ObtenerDriveScale) :bForce false)
)